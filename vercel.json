{
  "services": {
    "web": { "root": "web/" },
    "api": {
      "root": ".",
      "entrypoint": "api.index:app"
    }
  },
  "rewrites": [
    { "source": "/next-poc(.*)", "destination": { "service": "web" } },
    { "source": "/games", "destination": { "service": "web" } },
    { "source": "/(.*)", "destination": { "service": "api" } }
  ]
}
